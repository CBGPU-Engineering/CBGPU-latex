[Unit]
Description=CBGPU LaTeX compiler
After=network-online.target
[Service]
WorkingDirectory=@LATEX_SOURCE@
Environment=CBGPU_LATEX_SOURCE=@LATEX_SOURCE@
Environment=CBGPU_LATEX_PRIVATE=@LATEX_PRIVATE@
EnvironmentFile=-%h/.config/cbgpu/latex-rust.env
ExecStart=@LATEX_BINARY@ compiler
Restart=on-failure
RestartSec=5
UMask=0077
[Install]
WantedBy=default.target
