{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "scripts/**/*.mts",
    "ArchiveManager.mts",
    "LocalCommandRunner.ts",
    "bridge.mts",
    "editor.ts",
    "overleaf-runtime.d.ts"
  ]
}
